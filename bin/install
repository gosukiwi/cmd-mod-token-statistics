#!/usr/bin/env bash
#
# Install the token-statistics mod for Command Code.
#
# Copies token-statistics.ts into the Command Code mods directory so it loads in every
# project. There is no config template to write — the mod creates its own state file the
# first time it runs (see README).
#
# Override the destination with COMMANDCODE_MODS_DIR if you keep mods elsewhere.

set -euo pipefail

MOD_NAME="token-statistics"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE="$REPO_ROOT/$MOD_NAME.ts"

MODS_DIR="${COMMANDCODE_MODS_DIR:-$HOME/.commandcode/mods}"
TARGET="$MODS_DIR/$MOD_NAME.ts"

if [[ ! -f "$SOURCE" ]]; then
	echo "error: cannot find $SOURCE" >&2
	exit 1
fi

mkdir -p "$MODS_DIR"
cp "$SOURCE" "$TARGET"
echo "installed mod → $TARGET"

cat <<'NEXT'

Next steps:
  1. Restart Command Code, or run /reload in an open session.
  2. Send a prompt — the footer shows live session totals, tok/s and context usage.
  3. Run /token-stats for the full breakdown, and see
     ~/.commandcode/token-statistics.log.jsonl for the per-run history.

Docs: see README.md
NEXT
